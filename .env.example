# GlobeNews environment variables.
# Local: copy to .env.local and fill in. Production: add in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# --- Required ---
# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional ---
# Public site URL for metadata, sitemap and robots. Defaults to https://global-news-2vfy.vercel.app
NEXT_PUBLIC_SITE_URL=
# AI key-point summaries (server only). https://console.anthropic.com -> API keys. Without it, summaries are skipped.
ANTHROPIC_API_KEY=
# Extra news source (server only). https://gnews.io (free tier). Without it, GNews is skipped.
GNEWS_API_KEY=
# Extra news source (server only). https://newsdata.io (free tier, 200 credits/day). Without it, NewsData is skipped.
NEWSDATA_API_KEY=
